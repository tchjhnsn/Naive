{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lean-canvas.schema.json",
  "title": "Lean Canvas",
  "description": "The framework's Lean Canvas (Maurya 2012) as the venture's shared kernel (EE-155): nine boxes, each a reference to a record attribute its owning function writes.",
  "type": "object",
  "required": ["version", "boxes"],
  "properties": {
    "version": { "type": "string" },
    "note": { "type": "string" },
    "standard": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "adapted_from": { "type": "string" }
      },
      "additionalProperties": false
    },
    "boxes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "ask", "record", "attribute"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string" },
          "ask": { "type": "string" },
          "record": { "type": "string", "description": "The record type the box reads; its function in data-model.json owns the box" },
          "attribute": { "type": "string", "description": "A dotted path in the record, or . for the whole record" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
