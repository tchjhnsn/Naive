{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exit.schema.json",
  "title": "Exit",
  "description": "How the venture might end and what each owner would get, at <venture>/governance/exit.json (EE-022): the exit paths it keeps open and the sale values to model. Payouts are never typed here: packages/naive/src/engine/payouts.mjs computes them from ownership.json for each scenario.",
  "type": "object",
  "required": [
    "paths"
  ],
  "additionalProperties": false,
  "properties": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "stance"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "acquisition",
              "ipo",
              "secondary-sale",
              "merger",
              "management-buyout",
              "wind-down",
              "hold"
            ],
            "description": "hold: no exit, the owners keep it"
          },
          "stance": {
            "enum": [
              "preferred",
              "open",
              "ruled-out"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "description": "Proceeds to the owners after debts and costs"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
