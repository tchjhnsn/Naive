{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "people.schema.json",
  "title": "People",
  "description": "The venture's people (people/people.json): who is in it, in which role, and which functions (hats) each owns. It is to human capital what venture.json is to the venture. A founder also has a file in people/founders/. Names only: no personal details.",
  "type": "object",
  "required": [
    "venture",
    "mode",
    "people"
  ],
  "additionalProperties": false,
  "properties": {
    "venture": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "solo",
        "team"
      ],
      "description": "solo: one person owns every function the venture imports"
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "A role id from governance/venture-template/roles/venture-roles.json"
          },
          "hats": {
            "type": "array",
            "items": {
              "enum": [
                "strategy",
                "products",
                "marketing-and-sales",
                "supply-chain",
                "service-delivery",
                "customer-service",
                "human-capital",
                "it",
                "finance",
                "assets",
                "risk-and-compliance",
                "external-relationships",
                "capabilities"
              ]
            },
            "uniqueItems": true,
            "description": "The functions this person owns. In the structured layout (EE-086) hats are read from the org chart in venture.json and not stored here"
          },
          "founder_file": {
            "type": "string",
            "pattern": "^people/founders/[a-z0-9-]+\\.json$"
          }
        }
      }
    },
    "founder_agreement": {
      "type": "string",
      "description": "The founder agreement, once there is one (governance/founder-agreement.json)"
    },
    "updated": {
      "type": "string",
      "format": "date"
    }
  }
}
