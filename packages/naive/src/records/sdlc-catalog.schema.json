{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc-catalog.schema.json",
  "title": "SDLC catalog",
  "description": "Naive's knowledge of the software development life cycle (R-26), after ISO/IEC/IEEE 12207: process groups, processes, activities and tasks, each task with the decision classes it needs, the phase it is first needed in and its owning role. It holds no execution detail: MAD owns how (R-27) and the agent router owns who does it (R-25). A task is referred to as <mad_module>/<activity>/<task>, the form MAD's method-request uses. Checked across files by packages/naive/src/checks/check-sdlc-catalog.ts.",
  "type": "object",
  "required": [
    "sdlc_catalog",
    "version",
    "standard",
    "groups"
  ],
  "additionalProperties": false,
  "properties": {
    "sdlc_catalog": {
      "const": "0.2.0"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "standard": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "processes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "agreement",
              "organizational-project-enabling",
              "technical-management",
              "technical"
            ]
          },
          "name": {
            "type": "string"
          },
          "processes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "clause",
                "function",
                "owner_role"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "name": {
                  "type": "string"
                },
                "clause": {
                  "type": "string",
                  "pattern": "^6\\.[1-4]\\.\\d+$"
                },
                "function": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "description": "The venture function (one of the 13 APQC categories in packages/naive/src/functions/departments.json) whose work this process is. The software processes are mostly the products function's; operating the software is IT's, and the organizational processes belong where APQC files them. The check makes sure it names a department."
                },
                "mad_module": {
                  "description": "Technical processes only: the MAD process module that routes its methods, or null when it is not MAD's (business or mission analysis is the product function's).",
                  "allOf": [
                    {
                      "enum": [
                        "requirements",
                        "system-design",
                        "implementation",
                        "integration",
                        "verification",
                        "transition",
                        "validation",
                        "operation",
                        "maintenance",
                        null
                      ]
                    }
                  ]
                },
                "mad_layer": {
                  "description": "Other groups: the MAD layer whose questions cover how it is run.",
                  "enum": [
                    "governance",
                    "delivery",
                    "software-engineering",
                    "automation"
                  ]
                },
                "owner_role": {
                  "allOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    }
                  ]
                },
                "note": {
                  "type": "string"
                },
                "activities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "tasks"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "enum": [
                          "prepare",
                          "perform",
                          "manage-results"
                        ]
                      },
                      "name": {
                        "type": "string"
                      },
                      "tasks": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "name",
                            "decision_classes",
                            "needed_from",
                            "owner_role"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9-]*$"
                            },
                            "name": {
                              "type": "string"
                            },
                            "decision_classes": {
                              "description": "Decision classes the task needs, from the venture's decision rights.",
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9-]*$"
                              },
                              "uniqueItems": true
                            },
                            "needed_from": {
                              "description": "The earliest phase in which a venture building software needs this task.",
                              "allOf": [
                                {
                                  "enum": [
                                    "discovery",
                                    "validation",
                                    "beachhead",
                                    "scale",
                                    "platform"
                                  ]
                                }
                              ]
                            },
                            "owner_role": {
                              "description": "The role that owns the task's decisions, a role template id.",
                              "allOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[a-z][a-z0-9-]*$"
                                }
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
