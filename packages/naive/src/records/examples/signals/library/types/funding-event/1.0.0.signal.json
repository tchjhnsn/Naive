      "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
    }
  },
  "projects": [],
  "freshness": { "max_age": "30d" },
  "cases": [
    {
      "id": "informs-listeners-only",
      "given": [
        { "subject": "acme-robotics", "time": "2026-11-05", "props": { "series": "seed", "amount": 3000000, "currency": "USD" } }
      ],
      "expect": {},
      "note": "It projects nothing by itself; composites and edge listeners use it."
    }
  ]
}
