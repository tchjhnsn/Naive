{
  "listeners": [
    {
      "id": "track-competitors",
      "hears": "competitor-funding@^1",
      "consumer": { "route": "competitors/[id]/signals" },
      "criterion": {
        "rating": { "reliability": "C", "credibility": 3 },
        "predicates": [
          { "id": "known-competitor", "field": "subject", "op": "in", "value": { "ids": "competitors" }, "why": "Only companies a person or a signal already made a competitor" }
        ]
      },
      "then": "project",
      "note": "Records what the market did."
    },
    {
      "id": "rival-raised",
      "hears": "competitor-funding@^1",
      "consumer": { "decision": "rival-raised" },
      "criterion": {
        "rating": { "reliability": "B", "credibility": 2 },
        "predicates": [
          { "id": "in-our-markets", "field": "props.org.domain", "op": "exists" },
          { "id": "not-out-of-scope", "field": "props.org.name", "op": "not-in", "value": { "read": "foundation/icp/shop-owners.json#not" }, "why": "A company the ICP marks out of scope, such as the reseller the venture sells through, raises no decision" }
        ]
      },
      "then": "propose",
      "max_age": "14d",
      "note": "Bears on when to raise, so it proposes a decision."
    },
    {
      "id": "large-rounds-in-market",
      "hears": "funding-event@^1",
      "consumer": { "route": "competitors/[id]" },
      "criterion": {
        "predicates": [
          { "id": "ten-million-or-more", "field": "props.amount", "op": "gte", "value": 10000000, "why": "Only rounds that move the market" }
        ]
      },
      "then": "revalidate",
      "note": "Hears the round part of every competitor-funding signal. A round of ten million or more may change how the venture stands toward that competitor, so it marks the person's master record stale for review; a three million seed round is noise here."
    }
  ],
  "listeners_off": []
}
