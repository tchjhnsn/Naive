{
  "register": "delegation",
  "updated": "2026-10-29",
  "template": true,
  "note": "Default delegation. The founder grants the chief of staff the operations classes, which it may pass on; strategy, experience design, public commitments and money are granted directly and never passed on (the spend register's upkeep and cancel-or-downgrade go straight to the finance agent, founder-to-finance-agent); one-way doors stay with the founder. The chief of staff grants each lead (a role with a portfolio) accept-verified-work and defer-or-route over the venture, and set-priorities over its own lead plan only (operations/leads/<lead>), a two-way door (lead agents design, defaults 3 and 4). A venture customizes this in <venture>/governance/delegation.json.",
  "root": "founder",
  "never_redelegated": ["strategy-or-constitution", "experience-design", "public-commitment", "spend-money", "cancel-or-downgrade", "move-payment-method", "spend-register-upkeep"],
  "one_way_doors": ["irreversible-data-change", "ownership-or-control", "legal-or-terms", "continue-or-stop", "change-direction", "contradicts-ledger", "production-ship"],
