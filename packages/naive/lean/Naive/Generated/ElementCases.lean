/-! ## propagate: each case checked after `n + 1` rounds, which `effectsOf_eq` lifts to `propagate` -/

/-- an absent root degrades a chain and caps its levels -/
example : effectsOf (netL 3 [.absent, .operating, .operating] [0, 3, 3] [((0 : Fin 3), (1 : Fin 3)), ((1 : Fin 3), (2 : Fin 3))] 1) =
    [(.absent, 0, ([(0 : Fin 3)] : List (Fin 3))),
      ((.degraded [(.upstream 0 .absent)] .operating), 1, ([(0 : Fin 3)] : List (Fin 3))),
      ((.degraded [(.upstream 1 .degraded)] .operating), 2, ([(0 : Fin 3)] : List (Fin 3)))] := by
  rw [effectsOf_eq _ 4 (by decide)]; decide

/-- a strong upstream does not raise what it feeds -/
example : effectsOf (netL 3 [.operating, .operating, .operating] [3, 1, 1] [((0 : Fin 3), (1 : Fin 3)), ((1 : Fin 3), (2 : Fin 3))] 1) =
    [(.operating, 3, ([] : List (Fin 3))),
      (.operating, 1, ([] : List (Fin 3))),
      (.operating, 1, ([] : List (Fin 3)))] := by
  rw [effectsOf_eq _ 4 (by decide)]; decide

/-- absent and retired downstream elements stay as they are -/
example : effectsOf (netL 3 [.absent, .absent, .retired] [0, 0, 0] [((0 : Fin 3), (1 : Fin 3)), ((1 : Fin 3), (2 : Fin 3))] 1) =
