{
  "name": "naive-framework",
  "version": "0.6.0",
  "description": "Naive, a venture development framework: conventions, routes, records, checks and an agent interface for building a venture.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tchjhnsn/naive.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./packages/naive/src/*",
    "./lean/*": "./packages/naive/lean/*",
    "./schema/venture-paths.mjs": "./schema/venture-paths.mjs",
    "./packages/*": "./packages/*",
    "./governance/*": "./governance/*",
    "./frameworks/*": "./frameworks/*",
    "./library/*": "./packages/naive/library/*",
    "./docs/*": "./docs/*"
  },
  "bin": {
    "naive": "packages/naive/src/interfaces/cli/naive.mjs",
    "mentura": "packages/naive/src/interfaces/cli/mentura.mjs"
  },
  "scripts": {
    "test": "node test.mjs",
    "lint": "eslint .",
    "typecheck": "node packages/naive/src/checks/check-types.ts"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "LICENSE",
    ".claude-plugin/plugin.json",
    "schema/",
    "scripts/diagnose-transcripts.mjs",
    "packages/",
    "governance/",
    "frameworks/",
    "docs/reference/",
    "docs/decisions/",
    "packages/naive/src/terms/ontology.md",
    "packages/naive/src/terms/ontology.json",
    "packages/naive/src/terms/ontology-catalog.json",
    "docs/upgrades/",
    "beta/",
    "docs/design/NAIVE_NEXTJS_TRANSLATION_2026-10-28.md",
    "docs/design/naive-nextjs-status.json",
    "packages/naive/lean/Naive/",
    "packages/naive/lean/README.md",
    "!**/*test.mjs",
    "!**/*-test.mjs",
    "!**/test.mjs",
    "!**/*.steps.mjs",
    "!**/*.feature",
    "!packages/create-venture/package.json",
    "!**/.env*",
    "!**/*.pem",
    "!**/*.key",
    "!**/_private/",
    "!**/_internal/",
    "!packages/naive/src/checks/check-types.ts",
    "!packages/naive/src/checks/check-types-test.ts",
    "!packages/naive/src/records/record-types.ts",
    "!packages/naive/src/records/record-types-test.ts",
    "!**/.DS_Store"
  ],
  "keywords": [
    "venture",
    "framework",
    "startup",
    "agents",
    "mcp"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
