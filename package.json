{
  "name": "naive-framework",
  "version": "0.6.0",
  "description": "Naive, a venture development framework: conventions, routes, records, checks and an agent interface for building a venture.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tchjhnsn/naive.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./src/*.d.ts": "./dist/packages/naive/src/*.d.ts",
    "./src/*.ts": {
      "types": "./packages/naive/src/*.ts",
      "default": "./dist/packages/naive/src/*.mjs"
    },
    "./src/*": {
      "types": "./packages/naive/src/*",
      "default": "./dist/packages/naive/src/*"
    },
    "./lean/*": "./dist/packages/naive/lean/*",
    "./schema/venture-paths.mjs": {
      "types": "./schema/venture-paths.mjs",
      "default": "./dist/schema/venture-paths.mjs"
    },
    "./packages/*.d.ts": "./dist/packages/*.d.ts",
    "./packages/*.ts": {
      "types": "./packages/*.ts",
      "default": "./dist/packages/*.mjs"
    },
    "./packages/*": {
      "types": "./packages/*",
      "default": "./dist/packages/*"
    },
    "./template/*": "./dist/packages/naive/template/*",
    "./frameworks/*": {
      "types": "./frameworks/*",
      "default": "./dist/frameworks/*"
    },
    "./library/*": "./dist/packages/naive/library/*",
    "./docs/*": "./dist/docs/*"
  },
  "bin": {
    "naive": "dist/packages/naive/src/interfaces/cli/naive.mjs",
    "mentura": "dist/packages/naive/src/interfaces/cli/mentura.mjs"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepare": "node scripts/build.ts",
    "test": "node test.ts",
    "lint": "eslint .",
    "typecheck": "node packages/naive/src/checks/check-types.ts"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "dist/",
    "!dist/.build-stamp",
    ".claude-plugin/plugin.json",
    "schema/",
    "scripts/diagnose-transcripts.ts",
    "packages/",
    "governance/",
    "frameworks/",
    "docs/reference/",
    "docs/decisions/",
    "packages/naive/src/terms/ontology.md",
    "packages/naive/src/terms/ontology.json",
    "packages/naive/src/terms/ontology-catalog.json",
    "docs/upgrades/",
    "beta/",
    "docs/design/NAIVE_NEXTJS_TRANSLATION_2026-10-28.md",
    "docs/design/naive-nextjs-status.json",
    "packages/naive/lean/Naive/",
    "packages/naive/lean/README.md",
    "!**/*test.mjs",
    "!**/*-test.mjs",
    "!**/test.mjs",
    "!**/*-test.ts",
    "!**/test.ts",
    "!**/*.steps.mjs",
    "!**/*.steps.ts",
    "!**/*.feature",
    "!packages/create-venture/package.json",
    "!**/.env*",
    "!**/*.pem",
    "!**/*.key",
    "!**/_private/",
    "!**/_internal/",
    "!packages/naive/src/checks/check-types.ts",
    "!packages/naive/src/checks/check-types-test.ts",
    "!packages/naive/src/records/record-types.ts",
    "!packages/naive/src/records/record-types-test.ts",
    "!**/.DS_Store"
  ],
  "keywords": [
    "venture",
    "framework",
    "startup",
    "agents",
    "mcp"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.20.5",
    "effect": "4.1.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "effect": "4.1.5"
  }
}
