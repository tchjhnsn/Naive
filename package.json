{
  "name": "naive-framework",
  "version": "0.6.0",
  "description": "Naive, a venture development framework: conventions, routes, records, checks and an agent interface for building a venture.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tchjhnsn/everything-ecosystem.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "console",
    "site"
  ],
  "bin": {
    "naive": "interface/cli/naive.mjs",
    "mentura": "interface/cli/mentura.mjs"
  },
  "scripts": {
    "test": "node test.mjs",
    "lint": "eslint .",
    "typecheck": "node schema/check-types.ts"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "LICENSE",
    ".claude-plugin/plugin.json",
    "interface/",
    "schema/",
    "scripts/diagnose-transcripts.mjs",
    "packages/",
    "purpose/",
    "knowledge/",
    "operations/",
    "governance/",
    "evidence/",
    "platform/",
    "frameworks/",
    "docs/reference/",
    "docs/decisions/",
    "docs/ontology.md",
    "docs/ontology.json",
    "!**/*test.mjs",
    "!**/*-test.mjs",
    "!**/test.mjs",
    "!**/*.steps.mjs",
    "!**/*.feature",
    "!interface/create-venture/package.json",
    "!platform/integrations/fixtures/",
    "!platform/research/",
    "!schema/examples/docket-scenarios.json",
    "!**/.env*",
    "!**/*.pem",
    "!**/*.key",
    "!**/_private/",
    "!**/_internal/",
    "!platform/agents/",
    "!schema/check-types.ts",
    "!schema/check-types-test.ts",
    "!schema/record-types.ts",
    "!schema/record-types-test.ts",
    "!**/.DS_Store"
  ],
  "keywords": [
    "venture",
    "framework",
    "startup",
    "agents",
    "mcp"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
