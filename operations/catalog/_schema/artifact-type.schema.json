{
  "title": "catalog-artifact-type",
  "type": "object",
  "required": ["type", "id", "name", "question-answered", "readers", "use", "notations", "formats", "use-when", "unfit-when", "lifecycle", "last-checked", "source", "created", "ai-model", "tags"],
  "properties": {
    "type": { "enum": ["catalog-artifact-type"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string" },
    "question-answered": { "type": "string" },
    "readers": { "type": "array", "minItems": 1, "items": { "enum": ["person", "agent", "machine", "outside-party"] } },
    "use": { "type": "array", "minItems": 1, "items": { "enum": ["executed", "checked", "read"] } },
    "notations": { "type": "array", "items": { "type": "string" } },
    "formats": { "type": "array", "items": { "type": "string" } },
    "alternatives": { "type": "array", "items": { "type": "string" } },
    "use-when": { "type": "array", "items": { "type": "string" } },
    "unfit-when": { "type": "array", "items": { "type": "string" } },
    "lifecycle": { "enum": ["candidate", "listed", "evidenced", "deprecated", "re-check"] },
    "last-checked": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source": { "enum": ["human", "machine", "hybrid"] },
    "created": { "type": "string" },
    "ai-model": { "type": "string" },
    "tags": { "type": "array" }
  }
}
