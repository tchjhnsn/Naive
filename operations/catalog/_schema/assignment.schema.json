{
  "title": "methodology-assignment",
  "type": "object",
  "required": ["type", "id", "entity", "system", "methodology", "status", "answers", "source", "created", "ai-model", "tags"],
  "properties": {
    "type": { "enum": ["methodology-assignment"] },
    "id": { "type": "string", "pattern": "^A-[0-9]{3}$" },
    "entity": { "type": "string" },
    "system": { "type": "string" },
    "methodology": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "status": { "enum": ["proposed", "ratified", "in-force", "switched", "retired"] },
    "ratified-by": { "type": "string" },
    "ratified-on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "ledger-ref": { "type": "string" },
    "supersedes": { "type": "string" },
    "answers": { "type": "object", "propertyNames": { "pattern": "^M([1-9]|1[0-2])$" }, "additionalProperties": { "type": "object", "required": ["value", "basis"], "properties": { "value": { "type": "string" }, "basis": { "enum": ["tested", "assumed"] } } } },
    "artifact-types": { "type": "array", "items": { "type": "string" } },
    "recommendation-ref": { "type": "string" },
    "source": { "enum": ["human", "machine", "hybrid"] },
    "created": { "type": "string" },
    "ai-model": { "type": "string" },
    "tags": { "type": "array" }
  }
}
