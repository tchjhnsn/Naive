{
  "name": "naive-site",
  "private": true,
  "description": "Naive's developer docs and marketing pages, built with Nextra on Next.js. Its own npm project inside the Naive repository, using Naive from the same checkout. Unpublished until the owner approves (EE-025, EE-088).",
  "type": "module",
  "scripts": {
    "data": "node scripts/data.mjs && node scripts/venture-facts.mjs && node scripts/tokens.mjs",
    "predev": "npm run data && node scripts/nextra-meta.mjs",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "postinstall": "node scripts/patch-nextra.mjs",
    "prebuild": "npm run data && node scripts/nextra-meta.mjs && node scripts/patch-nextra.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "postbuild": "node scripts/search-index.mjs && node scripts/gate-pages.ts",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "check:content": "node scripts/check-content.mjs",
    "artifact": "npm run data && node scripts/artifact.mjs"
  },
  "dependencies": {
    "naive-framework": "file:..",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "pg": "^8.13.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
