{
  "$description": "Minimal tokens for the Naive docs and marketing pages. The brand pillar is unchanged. Mapped onto the site CSS variables by scripts/tokens.mjs.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0392],
        "hex": "#0a0a0a"
      }
    },
    "accent-on": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    },
    "muted": {
      "$type": "color",
      "$description": "Secondary text. Dark enough for WCAG 2.2 AA on the light page background.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2471, 0.2471, 0.2745],
        "hex": "#3f3f46"
      }
    },
    "move": {
      "$type": "color",
      "$description": "The next move: the primary action. Black on white, and white on black. No accent hue (founder, 2026-11-27).",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0392],
        "hex": "#0a0a0a"
      }
    },
    "move-on": {
      "$type": "color",
      "$description": "Text on the move colour.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    },
    "ink": {
      "$type": "color",
      "$description": "Marketing black.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0392],
        "hex": "#0a0a0a"
      }
    },
    "paper": {
      "$type": "color",
      "$description": "Marketing white.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "hex": "#ffffff"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["ui-sans-serif", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
    },
    "display": {
      "$type": "fontFamily",
      "$description": "Fallback stack behind the display face (Anton, loaded in app/layout.tsx).",
      "$value": ["Arial Narrow", "Impact", "sans-serif"]
    }
  },
  "radius": {
    "md": {
      "$type": "dimension",
      "$value": { "value": 8, "unit": "px" }
    },
    "sm": {
      "$type": "dimension",
      "$description": "Sharp corners for marketing cards and buttons.",
      "$value": { "value": 4, "unit": "px" }
    }
  }
}
