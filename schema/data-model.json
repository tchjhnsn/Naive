{
  "version": "0.5.0",
  "note": "The data model of the Everything Ecosystem: every record type, the layer that owns it, its schema, where its records live and what it references. No one schema holds everything; this file names them all and how they connect. schema/check-data-model.mjs fails when a JSON file in the repo has no record type here (or no ignore entry), when a schema file is unnamed, or when a kit claims a record of another layer. schema/validate.py reads it to validate every record. Levels: method (this repo, the method's own records), workspace (one per builder), venture (inside a venture folder).",
  "layers": [
    "purpose",
    "knowledge",
    "operations",
    "execution",
    "evidence",
    "governance",
    "interface"
  ],
  "records": [
    {
      "id": "workspace",
      "layer": "system",
      "level": "workspace",
      "schema": "schema/workspace.schema.json",
      "paths": [
        "instance/workspace.json",
        "schema/examples/workspace/workspace.json"
      ],
      "contains": [
        "venture"
      ]
    },
    {
      "id": "venture",
      "layer": "system",
      "level": "venture",
      "schema": "schema/venture.schema.json",
      "paths": [
        "instance/**/venture.json",
        "schema/examples/**/venture.json"
      ],
      "contains": [
        "venture",
        "venture-profile",
        "product",
        "account",
        "anatomy-answers",
        "mad-answers",
        "handoff",
        "evidence",
        "decision-rights",
        "pillar",
        "ownership",
        "board",
        "founder-agreement",
        "exit",
        "telos"
      ],
      "refs": [
        {
          "field": "parent",
          "to": "venture",
          "checked_by": "schema/check-ventures.mjs"
        },
        {
          "field": "profile",
          "to": "venture-profile",
          "checked_by": null
        },
        {
          "field": "governed_by",
          "to": "decision",
          "checked_by": null
        }
      ],
      "note": "The root record of a venture. It names the profile but does not contain it"
    },
    {
      "id": "venture-profile",
      "layer": "knowledge",
      "level": "venture",
      "schema": null,
      "form": "prose",
      "paths": [
        "instance/**/profile.md"
      ],
      "note": "The venture's story and thesis in prose. Guidance still in knowledge/references/entity-profile-schema.md (retired name)"
    },
    {
      "id": "product",
      "layer": "purpose",
      "level": "venture",
      "schema": "schema/product.schema.json",
      "paths": [
        "instance/**/products/*.json",
        "schema/examples/**/products/*.json"
      ],
      "refs": [
        {
          "field": "part_of",
          "to": "product",
          "checked_by": "schema/check-ventures.mjs"
        },
        {
          "field": "flows_to",
          "to": "product",
          "checked_by": "schema/check-ventures.mjs"
        },
        {
          "field": "business_model",
          "to": "business-models",
          "checked_by": "schema/check-ventures.mjs"
        }
      ]
    },
    {
      "id": "account",
      "layer": "purpose",
      "level": "venture",
      "schema": "schema/account.schema.json",
      "paths": [
        "instance/**/accounts/*/account.json",
        "schema/examples/**/accounts/*/account.json"
      ],
      "refs": [
        {
          "field": "products",
          "to": "product",
          "checked_by": "schema/check-ventures.mjs"
        }
      ],
      "note": "A named party the venture keeps a record for: client, customer, user, member or partner (EE-021). Optional"
    },
    {
      "id": "telos",
      "layer": "purpose",
      "level": "venture",
      "schema": "schema/telos.schema.json",
      "paths": [
        "instance/**/purpose/telos.json",
        "schema/examples/**/purpose/telos.json"
      ],
      "refs": [
        {
          "field": "phases.exit_criteria.serves",
          "to": "telos",
          "checked_by": "schema/check-telos.mjs"
        },
        {
          "field": "owner_outcome.path",
          "to": "exit",
          "checked_by": "schema/check-telos.mjs"
        },
        {
          "field": "phases.phase",
          "to": "anatomy-framework",
          "checked_by": "schema/validate.py"
        }
      ],
      "note": "The end the venture exists to reach: statement, end state, measures, owner outcome, exit criteria per phase (EE-023)"
    },
    {
      "id": "validation-problem",
      "layer": "purpose",
      "level": "venture",
      "schema": "schema/validation-problem.schema.json",
      "paths": [
        "instance/**/purpose/validation/problem.json",
        "schema/examples/**/purpose/validation/problem.json"
      ],
      "refs": [
        {
          "field": "evidence.source.path",
          "to": "(venture files)",
          "checked_by": "schema/check-validation.mjs"
        }
      ],
      "note": "The problem sub-score of validation: the claim and its cited evidence, each item graded (EE-026). Shares schema/validation-evidence.schema.json with every sub-score"
    },
    {
      "id": "validation-solution",
      "layer": "purpose",
      "level": "venture",
      "schema": "schema/validation-solution.schema.json",
      "paths": [
        "instance/**/purpose/validation/solution.json",
        "schema/examples/**/purpose/validation/solution.json"
      ],
      "refs": [
        {
          "field": "evidence.source.path",
          "to": "(venture files)",
          "checked_by": "schema/check-validation.mjs"
        }
      ],
      "note": "Validation sub-score: how it solves the problem and the evidence people choose it (EE-026)"
    },
    {
      "id": "validation-product-market-fit",
      "layer": "purpose",
      "level": "venture",
      "schema": "schema/validation-product-market-fit.schema.json",
      "paths": [
        "instance/**/purpose/validation/product-market-fit.json",
        "schema/examples/**/purpose/validation/product-market-fit.json"
      ],
      "refs": [
        {
          "field": "evidence.source.path",
          "to": "(venture files)",
          "checked_by": "schema/check-validation.mjs"
        }
      ],
      "note": "Validation sub-score: retention cohorts, Ellis survey and evidence that a segment keeps using it (EE-026)"
    },
    {
      "id": "validation-pricing",
      "layer": "purpose",
      "level": "venture",
      "schema": "schema/validation-pricing.schema.json",
      "paths": [
        "instance/**/purpose/validation/pricing.json",
        "schema/examples/**/purpose/validation/pricing.json"
      ],
      "refs": [
        {
          "field": "evidence.source.path",
          "to": "(venture files)",
          "checked_by": "schema/check-validation.mjs"
        }
      ],
      "note": "Validation sub-score: price model, points, buyer and evidence they pay (EE-026)"
    },
    {
      "id": "validation-go-to-market",
      "layer": "purpose",
      "level": "venture",
      "schema": "schema/validation-go-to-market.schema.json",
      "paths": [
        "instance/**/purpose/validation/go-to-market.json",
        "schema/examples/**/purpose/validation/go-to-market.json"
      ],
      "refs": [
        {
          "field": "evidence.source.path",
          "to": "(venture files)",
          "checked_by": "schema/check-validation.mjs"
        }
      ],
      "note": "Validation sub-score: path, motion, channels and evidence a channel works; the path sets the weights (EE-026)"
    },
    {
      "id": "validation-team",
      "layer": "purpose",
      "level": "venture",
      "schema": "schema/validation-team.schema.json",
      "paths": [
        "instance/**/purpose/validation/team.json",
        "schema/examples/**/purpose/validation/team.json"
      ],
      "refs": [
        {
          "field": "evidence.source.path",
          "to": "(venture files)",
          "checked_by": "schema/check-validation.mjs"
        }
      ],
      "note": "Validation sub-score: skills needed, held and the gaps; cofounder sought (EE-026)"
    },
    {
      "id": "validation-operations-readiness",
      "layer": "purpose",
      "level": "venture",
      "schema": "schema/validation-operations-readiness.schema.json",
      "paths": [
        "instance/**/purpose/validation/operations-readiness.json",
        "schema/examples/**/purpose/validation/operations-readiness.json"
      ],
      "refs": [
        {
          "field": "evidence.source.path",
          "to": "(venture files)",
          "checked_by": "schema/check-validation.mjs"
        }
      ],
      "note": "Validation sub-score: per MAD tier evidence; grades as the weakest tier (EE-026)"
    },
    {
      "id": "validation-weights",
      "layer": "purpose",
      "level": "method",
      "schema": null,
      "form": "json",
      "paths": [
        "purpose/kits/validation/weights.json"
      ],
      "note": "Validation score weights and floors by go-to-market path and venture kind (EE-026), version 0.x"
    },
    {
      "id": "anatomy-framework",
      "layer": "purpose",
      "level": "method",
      "schema": null,
      "form": "json",
      "paths": [
        "purpose/frameworks/product-anatomy/phases.json",
        "purpose/frameworks/product-anatomy/questions.json"
      ],
      "note": "Phases, gates and questions of Product Anatomy; self-describing, checked by its runner's tests"
    },
    {
      "id": "anatomy-answers",
      "layer": "purpose",
      "level": "venture",
      "schema": null,
      "form": "json",
      "paths": [
        "instance/**/purpose/anatomy.answers*.json",
        "purpose/frameworks/product-anatomy/examples/*.json"
      ],
      "refs": [
        {
          "field": "(keys)",
          "to": "product",
          "checked_by": "purpose/frameworks/product-anatomy/anatomy.mjs"
        }
      ],
      "note": "Scores per product per question; the matrix is rendered from them"
    },
    {
      "id": "decision",
      "layer": "knowledge",
      "level": "method",
      "schema": "schema/decision.schema.json",
      "paths": [
        "docs/decisions/decisions.json"
      ],
      "note": "A decision log. The schema's own is EE-NNN; a venture keeps its own log under its knowledge layer"
    },
    {
      "id": "design-document",
      "layer": "knowledge",
      "level": "method",
      "schema": null,
      "form": "markdown",
      "paths": [
        "docs/design/*.md"
      ],
      "note": "Domain, product, experience, interface and systems design documents; which ones a venture needs is in the design-documents registry"
    },
    {
      "id": "ontology",
      "layer": "system",
      "level": "method",
      "schema": null,
      "form": "json",
      "paths": [
        "docs/ontology.json"
      ],
      "note": "Canonical nouns; checked by schema/check-nouns.mjs, rendered to docs/ontology.md"
    },
    {
      "id": "reference",
      "layer": "system",
      "level": "method",
      "schema": "schema/reference.schema.json",
      "paths": [
        "*/references/references.json",
        "*/kits/*/references/references.json"
      ],
      "note": "Each layer keeps the sources behind its defaults; filled by knowledge/skills/find-reference; a kit inside a layer keeps its own at <layer>/kits/<kit>/references/references.json"
    },
    {
      "id": "integration",
      "layer": "system",
      "level": "method",
      "schema": "schema/integration.schema.json",
      "form": "json-list",
      "paths": [
        "*/tooling/integrations.json"
      ],
      "refs": [
        {
          "field": "reach",
          "to": "(layers)",
          "checked_by": "schema/check-integrations.mjs"
        }
      ],
      "note": "Each layer's tools; interfaces must reach at least four layers"
    },
    {
      "id": "business-models",
      "layer": "system",
      "level": "method",
      "schema": null,
      "form": "json",
      "paths": [
        "schema/vocab/business-models.json"
      ],
      "note": "Vocabulary: St. Gallen 55 plus named extras"
    },
    {
      "id": "scaffold",
      "layer": "system",
      "level": "method",
      "schema": null,
      "form": "json",
      "paths": [
        "schema/scaffold/defaults.json"
      ],
      "note": "Starting layers by phase, read by init-venture"
    },
    {
      "id": "data-model",
      "layer": "system",
      "level": "method",
      "schema": "schema/data-model.schema.json",
      "paths": [
        "schema/data-model.json"
      ],
      "note": "This file"
    },
    {
      "id": "kit-manifest",
      "layer": "system",
      "level": "method",
      "schema": "schema/kit.schema.json",
      "paths": [
        "*/kit.json",
        "*/kits/*/kit.json"
      ],
      "refs": [
        {
          "field": "records",
          "to": "(record types)",
          "checked_by": "schema/check-data-model.mjs"
        },
        {
          "field": "reads",
          "to": "(record types)",
          "checked_by": "schema/check-data-model.mjs"
        },
        {
          "field": "writes",
          "to": "(record types)",
          "checked_by": "schema/check-data-model.mjs"
        },
        {
          "field": "product",
          "to": "product",
          "checked_by": "schema/check-data-model.mjs"
        }
      ],
      "note": "What one kit holds: skills, record types it owns, record types it reads and writes, checks. A layer may hold more kits under <layer>/kits/<kit>/ (EE-026)"
    },
    {
      "id": "methodology",
      "layer": "operations",
      "level": "method",
      "schema": "operations/catalog/_schema/methodology.schema.json",
      "form": "markdown",
      "paths": [
        "operations/catalog/methodologies/*.md"
      ],
      "note": "Frontmatter checked by ee.mjs validate"
    },
    {
