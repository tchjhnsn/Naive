{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "venture.schema.json",
  "title": "Venture",
  "description": "One venture: anything a builder undertakes, from a hobby to a company (EE-011). Each venture keeps a venture.json at its root, beside its venture profile. Its products are cards in products/, its clients are records in clients/, and ventures can hold ventures. Cross-venture rules are checked by schema/check-ventures.mjs. Nouns follow docs/ontology.md (EE-014).",
  "type": "object",
  "required": [
    "id",
    "name",
    "parent",
    "phase",
    "owner",
    "status",
    "layers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ],
      "description": "The id of the venture that holds this one; null at the top of a workspace."
    },
    "phase": {
      "enum": [
        "discovery",
        "validation",
        "beachhead",
        "scale",
        "platform"
      ],
      "description": "How far the venture has come (EE-012). discovery: does a real problem exist, and who has it. validation: will people adopt this solution and keep using it. beachhead: can it win one segment repeatably at a profitable cost. scale: how fast can it take the mass market. platform: what will others build on. Gates and references: purpose/frameworks/product-anatomy/phases.json."
    },
    "ambition": {
      "enum": [
        "hobby",
        "survival",
        "lifestyle",
        "managed-growth",
        "aggressive-growth"
      ],
      "description": "Why the venture exists and how far through the phases it means to go. hobby follows the IRS sense: not engaged in for profit."
    },
    "form": {
      "type": "object",
      "description": "Whether and how the venture is formalized.",
      "properties": {
        "legal_form": {
          "enum": [
            "none",
            "sole-prop",
            "partnership",
            "llc",
            "s-corp",
            "c-corp",
            "benefit-corp",
            "nonprofit"
          ]
        },
        "funding": {
          "enum": [
            "bootstrapped",
            "grant",
            "angel",
            "venture-capital",
            "debt",
            "mixed"
          ]
        }
      },
      "additionalProperties": false
    },
    "industry": {
      "type": "object",
      "description": "What the venture produces, by its current flagship. Re-checked at each phase gate.",
      "required": [
        "system",
        "code"
      ],
      "properties": {
        "system": {
          "enum": [
            "naics"
          ],
          "description": "NAICS (North American Industry Classification System), production-oriented"
        },
        "code": {
          "type": "string",
          "pattern": "^\\d{2,6}$"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "core": {
      "type": "object",
      "description": "The core product (Product Anatomy): what anyone can claim from this venture. Required once the venture leaves discovery.",
      "required": [
        "promise",
        "promised_to",
        "must_not",
        "competence"
      ],
      "properties": {
        "promise": {
          "type": "string"
        },
        "promised_to": {
          "type": "string"
        },
        "must_not": {
          "type": "string",
          "description": "What it must never deliver under its name"
        },
        "competence": {
          "type": "string",
          "description": "The core competence that makes the promise deliverable (Prahalad and Hamel)"
        }
      },
      "additionalProperties": false
    },
    "owner": {
      "enum": [
        "self",
        "shared",
        "other"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles of the others in it (co-founder, partner, investor), not personal details. A second member switches on governance."
    },
    "governed_by": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "closed",
        "archived"
      ]
    },
    "opened": {
      "type": "string",
      "format": "date"
    },
    "closed": {
      "type": "string",
      "format": "date"
    },
    "profile": {
      "type": "string",
      "description": "Path to the venture profile (Markdown): narrative, pillars and changelog."
    },
    "layers": {
      "type": "object",
      "description": "Every venture has the same seven layers, at the depth it needs. A layer not used yet is false.",
      "required": [
        "purpose",
        "knowledge",
        "operations",
        "execution",
        "evidence"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/layer"
        },
        "knowledge": {
          "$ref": "#/$defs/layer"
        },
        "operations": {
          "$ref": "#/$defs/layer"
        },
        "execution": {
          "$ref": "#/$defs/layer"
        },
        "evidence": {
          "$ref": "#/$defs/layer"
        },
        "governance": {
          "$ref": "#/$defs/layer"
        },
        "interface": {
          "$ref": "#/$defs/layer"
        }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "array",
      "description": "What crosses from this venture into another, one way.",
      "items": {
        "type": "object",
        "required": [
          "to",
          "access",
          "carries"
        ],
        "properties": {
          "to": {
            "type": "string"
          },
          "access": {
            "enum": [
              "reads",
              "shares-with"
            ]
          },
          "carries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "border": {
            "enum": [
              "closed",
              "filtered",
              "open"
            ],
            "default": "filtered"
          }
        },
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "layer": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "required": [
            "location"
          ],
          "properties": {
            "location": {
              "type": "string"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "not": {
              "const": "discovery"
            }
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "core"
        ]
      }
    }
  ],
  "additionalProperties": false
}
