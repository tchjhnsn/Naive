{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement.schema.json",
  "title": "Requirement",
  "description": "A canonical requirement, at <venture>/foundation/requirements/<id>.json: something that must hold, derived from goals or their measures, by a phase, constraining named functions and verified by a check, evidence or a person. Read by validation and the decision index; framework-neutral.",
  "type": "object",
  "required": ["id", "statement", "derives_from"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "venture": { "type": "string" },
    "statement": { "type": "string" },
    "derives_from": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Goal ids or measure ids (goal/measure or a bare measure id)" },
    "must_hold_by": { "enum": ["discovery", "validation", "beachhead", "scale", "platform"] },
    "constrains": { "type": "array", "items": { "type": "string" }, "description": "Function ids from venture.json functions" },
    "verified_by": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": { "kind": { "enum": ["check", "evidence", "person"] }, "ref": { "type": "string" } }
    },
    "weight": { "type": "integer", "minimum": 1, "maximum": 3 },
    "framework": { "type": "string" },
    "updated": { "type": "string" }
  }
}
