{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board.schema.json",
  "title": "Boards",
  "description": "The venture's boards, at <venture>/governance/board.json (EE-022): at most one formal board of directors (or managers, or trustees), which holds legal authority, and any advisory boards, which advise and decide nothing. A seat says who fills it and who appoints them; reserved matters are what only the formal board may decide. schema/check-governance.mjs checks seats against ownership.json.",
  "type": "object",
  "required": [
    "updated",
    "boards"
  ],
  "additionalProperties": false,
  "properties": {
    "updated": {
      "type": "string",
      "format": "date"
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "seats"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "enum": [
              "formal",
              "advisory"
            ]
          },
          "formed": {
            "type": "string",
            "format": "date"
          },
          "meets": {
            "enum": [
              "monthly",
              "every-6-weeks",
              "quarterly",
              "twice-a-year",
              "yearly",
              "as-needed"
            ]
          },
          "seats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "appointed_by"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "person": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "null while the seat is empty"
                },
                "type": {
                  "enum": [
                    "founder",
                    "investor",
                    "independent",
                    "advisor",
                    "observer"
                  ]
                },
                "appointed_by": {
                  "type": "string",
                  "description": "A holder id, a class id from ownership.json, or 'board' (chosen by the board itself)"
                }
              }
            }
          },
          "reserved_matters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Formal boards only: decisions only this board may make, such as issuing shares, approving the budget, hiring or removing the CEO, selling the company"
          }
        }
      }
    }
  }
}
