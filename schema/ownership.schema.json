{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ownership.schema.json",
  "title": "Ownership (cap table)",
  "description": "Who owns the venture and on what terms, at <venture>/governance/ownership.json (EE-022): share classes and the rights each carries, holders, grants with vesting, the option pool, and unpriced instruments such as SAFEs. It is a record of what was agreed, not the legal document: the signed documents are the truth, and decisions to change this file are founder decisions made with counsel (decision class ownership-or-control). schema/check-governance.mjs checks it; schema/payouts.mjs computes payouts from it.",
  "type": "object",
  "required": [
    "updated",
    "unit",
    "classes",
    "holders",
    "grants"
  ],
  "additionalProperties": false,
  "properties": {
    "updated": {
      "type": "string",
      "format": "date"
    },
    "unit": {
      "enum": [
        "shares",
        "units",
        "percent"
      ],
      "description": "shares for a corporation, units for an LLC, percent for a partnership or an informal split"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "common",
              "preferred",
              "units"
            ],
            "description": "common and units are paid last; preferred carries a liquidation preference"
          },
          "votes_per_share": {
            "type": "number",
            "minimum": 0,
            "description": "1 by default; more than 1 for super-voting (dual-class) shares, 0 for non-voting"
          },
          "price_per_share": {
            "type": "number",
            "minimum": 0,
            "description": "Original issue price; the basis of a liquidation preference"
          },
          "liquidation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "multiple": {
                "type": "number",
                "minimum": 0,
                "description": "1 is standard (1x)"
              },
              "participating": {
                "type": "boolean",
                "description": "true: takes its preference and then shares the rest; false (standard): takes the greater of its preference or what it would get as common"
              },
              "seniority": {
                "type": "integer",
                "minimum": 0,
                "description": "Higher is paid first; equal ranks share pro rata (pari passu)"
              }
            }
          },
          "rights": {
            "type": "array",
            "items": {
              "enum": [
                "board-seat",
                "board-observer",
                "information",
                "pro-rata",
                "protective-provisions",
                "anti-dilution-broad-based",
                "anti-dilution-full-ratchet",
                "drag-along",
                "tag-along",
                "right-of-first-refusal",
                "co-sale",
                "registration",
                "redemption"
              ]
            },
            "description": "Investor rights this class carries"
          }
        }
      }
    },
    "holders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "founder",
              "employee",
              "advisor",
              "investor",
              "pool",
              "other"
            ],
            "description": "pool is the reserved option pool: its unissued amount is paid nothing"
          },
          "role": {
            "type": "string",
            "description": "The venture role they hold, if any"
          },
          "agreement": {
            "type": "string",
            "description": "Path to their signed agreement (advisor, employee, investment)"
          }
        }
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "holder",
          "class",
          "amount"
        ],
        "additionalProperties": false,
        "properties": {
          "holder": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "granted": {
            "type": "string",
            "format": "date"
          },
          "vesting": {
            "type": "object",
            "required": [
              "start",
              "months"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "format": "date"
              },
              "months": {
                "type": "integer",
                "minimum": 0,
                "description": "48 is common for founders and employees, 24 for advisors"
              },
              "cliff_months": {
                "type": "integer",
                "minimum": 0,
                "description": "12 is common"
              },
              "acceleration": {
                "enum": [
                  "none",
                  "single-trigger",
                  "double-trigger"
                ]
              }
            }
          }
        }
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "holder",
          "kind",
          "amount"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "holder": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "safe-post-money",
              "safe-pre-money",
              "convertible-note"
            ]
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "signed": {
            "type": "string",
            "format": "date"
          },
          "valuation_cap": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "discount": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "converts_to": {
            "type": "string",
            "description": "The class it converts into at the next priced round"
          },
          "rights": {
            "type": "array",
            "items": {
              "enum": [
                "board-seat",
                "board-observer",
                "information",
                "pro-rata",
                "protective-provisions",
                "anti-dilution-broad-based",
                "anti-dilution-full-ratchet",
                "drag-along",
                "tag-along",
                "right-of-first-refusal",
                "co-sale",
                "registration",
                "redemption"
              ]
            }
          }
        }
      }
    }
  }
}
