{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exit-criteria.schema.json",
  "title": "Exit criteria",
  "description": "A phase's canonical exit criteria, at <venture>/foundation/exit-criteria/<phase>.json: what must be true to leave the phase, each serving a goal measure. The lifecycle gate (schema/lifecycle.mjs) reads these; a criterion is met when a person says so.",
  "type": "object",
  "required": ["phase", "criteria"],
  "additionalProperties": false,
  "properties": {
    "phase": { "enum": ["discovery", "validation", "beachhead", "scale", "platform"] },
    "venture": { "type": "string" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "statement": { "type": "string" },
          "serves": { "type": "array", "items": { "type": "string" }, "description": "Measure ids this criterion moves the venture toward" },
          "evidence": { "type": "string" },
          "met": {
            "type": ["object", "null"],
            "required": ["by", "at"],
            "additionalProperties": false,
            "properties": { "by": { "type": "string" }, "at": { "type": "string", "format": "date-time" }, "evidence": { "type": "string" } }
          }
        }
      }
    },
    "framework": { "type": "string" },
    "updated": { "type": "string" }
  }
}
