{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "founder.schema.json",
  "title": "Founder",
  "description": "One founder of the venture (people/founders/<id>.json): role, the functions they own, when they joined, and where their founder agreement is. One file per founder, so each founder's record changes on its own.",
  "type": "object",
  "required": [
    "id",
    "name",
    "role",
    "joined"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "enum": [
        "founder",
        "co-founder",
        "general-partner"
      ]
    },
    "hats": {
      "type": "array",
      "items": {
        "enum": [
          "strategy",
          "products",
          "marketing-and-sales",
          "supply-chain",
          "service-delivery",
          "customer-service",
          "human-capital",
          "it",
          "finance",
          "assets",
          "risk-and-compliance",
          "external-relationships",
          "capabilities"
        ]
      },
      "uniqueItems": true,
      "description": "The functions this founder owns, in the flat layout. In the structured layout (EE-086) they are read from venture.json"
    },
    "joined": {
      "type": "string",
      "format": "date"
    },
    "agreement": {
      "type": "object",
      "required": [
        "path",
        "signed"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "signed": {
          "type": "boolean"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "description": "Who the founder is, in their own words, as a mentor learns it (Torian's playbook, step know-the-founder): the puzzle of their life and what they are for",
      "properties": {
        "puzzles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The problems they keep turning over"
        },
        "passions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "telos": {
          "type": "string",
          "description": "What a good life looks like for them; what they are for"
        },
        "ambitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What people come to them for"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confirmed": {
          "type": "boolean",
          "description": "The founder said the profile reads true"
        }
      }
    }
  }
}
