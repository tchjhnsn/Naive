{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-model.schema.json",
  "title": "Data model",
  "description": "The shape of schema/data-model.json (EE-018): every record type of the ecosystem, the layer that owns it, its schema, where its records live and what each references. schema/check-data-model.mjs checks it against the repository.",
  "type": "object",
  "required": [
    "version",
    "layers",
    "records",
    "ignore"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "layer",
          "level",
          "schema",
          "paths"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "layer": {
            "description": "The owning layer, or system for records every layer shares",
            "enum": [
              "system",
              "purpose",
              "knowledge",
              "operations",
              "evidence",
              "governance",
              "interface"
            ]
          },
          "level": {
            "description": "method: this repo's own records; workspace: one per builder; venture: inside a venture folder",
            "enum": [
              "method",
              "workspace",
              "venture"
            ]
          },
          "schema": {
            "type": [
              "string",
              "null"
            ],
            "description": "Path to the schema that governs it, or null when it has none yet"
          },
          "form": {
            "enum": [
              "json",
              "json-list",
              "markdown",
              "prose",
              "json-lines"
            ],
            "description": "Default json. json-list: the file holds a list of records. json-lines: one record per line, append-only"
          },
          "decision_class": {
            "type": "string",
            "description": "The decision class (governance/venture-template/decision-rights.json) a write of this record is. When the venture's decision rights put the class at escalate or recommend-approve, an agent's write through the router is held as a draft for a person to accept (EE-032)"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Globs from the repo root"
          },
          "contains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Record types that live inside this one's folder"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "to",
                "checked_by"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "to": {
                  "type": "string",
                  "description": "A record type id, or a parenthesised name for a non-record target"
                },
                "checked_by": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The check that resolves this reference, or null when nothing does yet"
                }
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
