{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "client.schema.json",
  "title": "Client",
  "description": "Work for one client, a record inside the venture that serves it at clients/<id>/client.json (EE-011). Not a venture: it has no phase or core.",
  "type": "object",
  "required": [
    "id",
    "name",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "prospect",
        "active",
        "paused",
        "closed"
      ]
    },
    "opened": {
      "type": "string",
      "format": "date"
    },
    "closed": {
      "type": "string",
      "format": "date"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ids of the venture's products this client buys"
    },
    "profile": {
      "type": "string"
    },
    "layers": {
      "type": "object",
      "description": "Optional: where this client's knowledge and execution records live",
      "properties": {
        "knowledge": {
          "$ref": "venture.schema.json#/$defs/layer"
        },
        "execution": {
          "$ref": "venture.schema.json#/$defs/layer"
        },
        "evidence": {
          "$ref": "venture.schema.json#/$defs/layer"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
